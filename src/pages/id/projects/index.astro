---
// Daftar proyek — semua proyek profesional dengan set field R6.
// Terjemahan yang hilang membuat build gagal di sini (assertLocalePairing).
import { getCollection } from 'astro:content';
import Base from '../../../layouts/base.astro';
import ProjectCard from '../../../components/project-card.astro';
import { t } from '../../../i18n/ui';
import { assertLocalePairing, entrySlug, getByLocale, sortProjects } from '../../../lib/content';

const lang = 'id' as const;

const all = await getCollection('projects');
assertLocalePairing(all);
const projects = sortProjects(getByLocale(all, lang));
---

<Base
  lang={lang}
  title={`${t(lang, 'site.name')} — ${t(lang, 'projects.listing')}`}
  description="Proyek profesional di bidang computer vision, machine learning, dan applied AI — dengan status jujur dan catatan disclosure untuk setiap entri."
>
  <section class="listing">
    <p class="kicker mono">{t(lang, 'nav.projects')}</p>
    <h1>{t(lang, 'projects.listing')}</h1>
    <p class="lede">
      Semua proyek profesional, dalam satu tempat. Studi kasus tertaut ke tulisan lengkap; setiap
      entri membawa status yang jujur dan catatan disclosure.
    </p>
    <div class="grid">
      {projects.map((entry) => (
        <ProjectCard entry={{ slug: entrySlug(entry.id), data: entry.data }} />
      ))}
    </div>
  </section>
</Base>

<style>
  .listing {
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--space-8) var(--container-pad) var(--space-9);
  }

  .kicker {
    color: var(--neon-magenta);
    font-size: var(--text-xs);
    letter-spacing: 0.18em;
    margin-bottom: var(--space-3);
  }

  h1 {
    font-size: var(--text-3xl);
  }

  .lede {
    max-width: 60ch;
    margin-top: var(--space-3);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .grid {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-6);
  }

  @media (min-width: 760px) {
    .grid {
      grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    }
  }
</style>
