---
import { getCollection } from 'astro:content';
import HomePage from '../../components/home-page.astro';
import Base from '../../layouts/base.astro';
import { t } from '../../i18n/ui';
import { getByLocale, sortProjects } from '../../lib/content';

const lang = 'id' as const;
const allProjects = await getCollection('projects');
const projects = sortProjects(getByLocale(allProjects, lang));
const featured = projects.filter((entry) => entry.data.featured);
---

<Base
  lang={lang}
  title="Silfaradila Mei — AI engineer untuk sistem operasional"
  description={t(lang, 'site.tagline')}
  footerVariant="home"
  pageClass="editorial-home"
  headerVariant="center"
>
  <HomePage lang={lang} featured={featured} projects={projects} projectCount={projects.length} />
</Base>
