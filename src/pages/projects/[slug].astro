---
import { getCollection, render } from 'astro:content';
import ProjectCaseStudy from '../../components/project-case-study.astro';
import { t } from '../../i18n/ui';
import Base from '../../layouts/base.astro';
import { assertLocalePairing, getByLocale } from '../../lib/content';

const lang = 'en' as const;

export async function getStaticPaths() {
  const all = await getCollection('projects');
  assertLocalePairing(all);
  return getByLocale(all, 'en')
    .filter((entry) => entry.data.kind === 'case-study')
    .map((entry) => ({
      params: { slug: entry.id.split('/')[1] },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const isFlagship = entry.data.diagram === 'sims';
---

<Base
  lang={lang}
  title={`${entry.data.title} — ${t(lang, 'site.name')}`}
  description={entry.data.overview}
  footerVariant={isFlagship ? 'compact' : 'medium'}
>
  <ProjectCaseStudy lang={lang} entry={entry} Content={Content} headings={headings} />
</Base>
