---
// Projects listing — every professional project with the R6 field set.
// A missing translation fails the build here (assertLocalePairing).
import { getCollection } from 'astro:content';
import Base from '../../layouts/base.astro';
import ProjectCard from '../../components/project-card.astro';
import { t } from '../../i18n/ui';
import { assertLocalePairing, entrySlug, getByLocale, sortProjects } from '../../lib/content';

const lang = 'en' as const;

const all = await getCollection('projects');
assertLocalePairing(all);
const projects = sortProjects(getByLocale(all, lang));
---

<Base
  lang={lang}
  title={`${t(lang, 'site.name')} — ${t(lang, 'projects.listing')}`}
  description="Professional projects across computer vision, machine learning, and applied AI — with honest status and disclosure for every entry."
>
  <section class="listing">
    <p class="kicker mono">{t(lang, 'nav.projects')}</p>
    <h1>{t(lang, 'projects.listing')}</h1>
    <p class="lede">
      Every professional project, in one place. Case studies link to full write-ups; each entry
      carries its honest status and a disclosure note.
    </p>
    <div class="grid">
      {projects.map((entry) => (
        <ProjectCard entry={{ slug: entrySlug(entry.id), data: entry.data }} />
      ))}
    </div>
  </section>
</Base>

<style>
  .listing {
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--space-8) var(--container-pad) var(--space-9);
  }

  .kicker {
    color: var(--neon-magenta);
    font-size: var(--text-xs);
    letter-spacing: 0.18em;
    margin-bottom: var(--space-3);
  }

  h1 {
    font-size: var(--text-3xl);
  }

  .lede {
    max-width: 60ch;
    margin-top: var(--space-3);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .grid {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-6);
  }

  @media (min-width: 760px) {
    .grid {
      grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    }
  }
</style>
