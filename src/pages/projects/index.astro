---
// Projects listing — every professional project with the R6 field set.
// A missing translation fails the build here (assertLocalePairing).
import { getCollection } from 'astro:content';
import Base from '../../layouts/base.astro';
import ProjectCard from '../../components/project-card.astro';
import { t } from '../../i18n/ui';
import { assertLocalePairing, entrySlug, getByLocale, sortProjects } from '../../lib/content';

const lang = 'en' as const;

const all = await getCollection('projects');
assertLocalePairing(all);
const projects = sortProjects(getByLocale(all, lang));
const professional = projects.filter((entry) => entry.data.type === 'professional');
const research = projects.filter((entry) => entry.data.type === 'research');
---

<Base
  lang={lang}
  title={`${t(lang, 'site.name')} — ${t(lang, 'projects.listing')}`}
  description={t(lang, 'projects.intro')}
>
  <section class="listing">
    <p class="kicker mono">{t(lang, 'nav.projects')}</p>
    <h1>{t(lang, 'projects.listing')}</h1>
    <p class="lede">{t(lang, 'projects.intro')}</p>
    <section class="group">
      <h2>{t(lang, 'projects.groups.professional')}</h2>
      <div class="grid">
        {professional.map((entry) => (
          <ProjectCard locale="en" entry={{ slug: entrySlug(entry.id), data: entry.data }} />
        ))}
      </div>
    </section>
    {research.length > 0 && (
      <section class="group">
        <h2>{t(lang, 'projects.groups.research')}</h2>
        <div class="grid">
          {research.map((entry) => (
            <ProjectCard locale="en" entry={{ slug: entrySlug(entry.id), data: entry.data }} />
          ))}
        </div>
      </section>
    )}
  </section>
</Base>

<style>
  .listing {
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--space-8) var(--container-pad) var(--space-9);
  }

  .kicker {
    color: var(--neon-magenta);
    font-size: var(--text-xs);
    letter-spacing: 0.18em;
    margin-bottom: var(--space-3);
  }

  h1 {
    font-size: var(--text-3xl);
  }

  .lede {
    max-width: 60ch;
    margin-top: var(--space-3);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .group {
    margin-top: var(--space-6);
  }

  .group h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-5);
  }

  .grid {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 760px) {
    .grid {
      grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    }
  }
</style>
