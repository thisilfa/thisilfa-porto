---
// Token showcase — scaffold placeholder. Replaced by the real Home page in U8;
// exists so design tokens (U4) are reviewable in the PR.
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Silfaradila Mei Fizahidah — token showcase</title>
  </head>
  <body>
    <header class="texture-grid hero">
      <p class="kicker mono">U4 · DESIGN TOKENS</p>
      <h1>Building intelligent systems through practical engineering.</h1>
      <p class="lede">
        Sample of the design system: display type, body copy at AA contrast, neon accents reserved
        for interactive elements.
      </p>
      <div class="chips">
        <span class="chip mono">Computer Vision</span>
        <span class="chip mono">Machine Learning</span>
        <span class="chip mono">LLM &amp; RAG</span>
        <span class="chip mono">Backend Engineering</span>
      </div>
    </header>
    <main class="wrap">
      <section class="card">
        <h2>Card surface (—surface-1)</h2>
        <p>
          Body copy sits here. <a href="#">This is a link</a> in neon magenta; focus it with the
          keyboard to see the focus ring, hover it to see the state shift.
        </p>
        <button class="cta">Primary CTA</button>
        <button>Quiet button</button>
      </section>
      <section class="card glow-violet">
        <h2>Same card, glow effect</h2>
        <p>
          The glow is a single token (--glow-violet), applied only to accent moments. The grid
          texture above fades out radially — both effects are static and honor
          prefers-reduced-motion.
        </p>
      </section>
    </main>
  </body>
</html>

<style>
  .hero {
    padding: var(--space-9) var(--container-pad) var(--space-8);
    max-width: var(--container);
    margin: 0 auto;
  }

  .kicker {
    color: var(--neon-magenta);
    font-size: var(--text-xs);
    letter-spacing: 0.18em;
    margin-bottom: var(--space-4);
  }

  .hero h1 {
    font-size: var(--text-4xl);
    max-width: 22ch;
  }

  .lede {
    margin-top: var(--space-4);
    max-width: 52ch;
    font-size: var(--text-lg);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }

  .chip {
    font-size: var(--text-xs);
    color: var(--text-muted);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-pill);
    padding: var(--space-1) var(--space-3);
  }

  .wrap {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 var(--container-pad) var(--space-9);
    display: grid;
    gap: var(--space-5);
  }

  .card {
    background: var(--surface-1);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .card h2 {
    font-size: var(--text-2xl);
  }

  .cta {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--surface-0);
    background: var(--neon-magenta);
    border-radius: var(--radius-pill);
    padding: var(--space-2) var(--space-5);
    transition:
      box-shadow var(--transition-fast),
      transform var(--transition-fast);
  }

  .cta:hover {
    box-shadow: var(--glow-magenta);
    transform: translateY(-1px);
  }

  button:not(.cta):hover {
    color: var(--neon-magenta);
  }
</style>
