---
// Resume — the web version of the CV. Education appears only in the
// downloadable PDF (origin R9 / AE3), never on this page.
import Base from '../layouts/base.astro';
import { t } from '../i18n/ui';
import { withBase } from '../lib/urls';

const lang = 'en' as const;

const experience = [
  {
    place: 'Biologic Technik Pte. Ltd.',
    role: 'Computer Vision Engineer',
    period: 'Computer Vision · Applied AI / LLM',
    points: [
      'Smart Inventory Management System — camera-based inventory counting, deployed in a hospital inventory environment.',
      'CSSD surgical instrument identification — detection, embeddings, similarity search (staging / experimental validation).',
      'Prophesy AI Prime — RAG pipeline, multi-provider LLM integration, automated collection workflows.',
    ],
  },
  {
    place: 'CV. Karya Hidup Sentosa (Quick Tractor)',
    role: 'Junior Machine Learning / Data Engineer',
    period: 'Computer Vision · ML engineering',
    points: [
      'WorkGuard — workplace violation detection with YOLOv8 and asynchronous processing.',
      'Face attendance system — recognition with anti-spoofing, TensorFlow Serving.',
      'Visual product search (CBIR) and YOLOv5 materials counting.',
    ],
  },
];

const skills = [
  { area: 'Programming', items: 'Python, SQL' },
  { area: 'Computer Vision', items: 'OpenCV, YOLO (v5/v8), SAM' },
  { area: 'Machine Learning', items: 'PyTorch, Scikit-learn' },
  { area: 'AI & LLM', items: 'RAG, ChromaDB, DINOv2, CLIP' },
  { area: 'Backend', items: 'FastAPI, Flask' },
  { area: 'Database & Search', items: 'PostgreSQL, pgvector, FAISS, Redis' },
  { area: 'Deployment', items: 'Docker, ONNX, Linux, Raspberry Pi' },
  { area: 'Automation', items: 'n8n' },
];

const selected = [
  { name: 'Smart Inventory Management System (SIMS)', slug: 'sims' },
  { name: 'CSSD Surgical Instrument Identification', slug: 'cssd-instrument-id' },
  { name: 'Prophesy AI Prime', slug: 'prophesy-ai-prime' },
];
---

<Base
  lang={lang}
  title={`${t(lang, 'site.name')} — ${t(lang, 'nav.resume')}`}
  description="Web resume of an AI Engineer: computer vision, machine learning, and applied AI across hospital systems, workplace safety, and LLM applications."
>
  <section class="resume">
    <header class="head texture-grid">
      <p class="kicker mono">{t(lang, 'nav.resume')}</p>
      <h1>{t(lang, 'site.name')}</h1>
      <p class="role">{t(lang, 'site.role')}</p>
      <p class="summary">
        AI Engineer with hands-on experience developing and integrating machine learning solutions —
        computer vision pipelines on edge devices, LLM applications with retrieval-augmented
        generation, and the backend infrastructure that makes them dependable.
      </p>
      <div class="actions">
        <a
          class="btn btn-primary"
          href={withBase('/downloads/silfaradila-mei-resume-en.pdf')}
          download
        >
          {t(lang, 'resume.download')}
        </a>
        <a class="btn btn-quiet" href={withBase('/contact/')}>
          {t(lang, 'home.contactCta')}
        </a>
      </div>
    </header>

    <section class="block">
      <h2>Work experience</h2>
      <div class="jobs">
        {experience.map((job) => (
          <div class="job">
            <div class="job-head">
              <p class="place">{job.place}</p>
              <p class="job-role">{job.role}</p>
              <p class="period mono">{job.period}</p>
            </div>
            <ul>
              {job.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="block">
      <h2>Selected projects</h2>
      <ul class="selected">
        {selected.map((project) => (
          <li>
            <a href={withBase(`/projects/${project.slug}/`)}>{project.name}</a>
          </li>
        ))}
      </ul>
      <p class="more">
        Full history on the <a href={withBase('/projects/')}>projects page</a> — nine professional
        projects with honest status labels.
      </p>
    </section>

    <section class="block">
      <h2>Technical skills</h2>
      <div class="skills">
        {skills.map((group) => (
          <div class="skill">
            <p class="mono area">{group.area}</p>
            <p>{group.items}</p>
          </div>
        ))}
      </div>
    </section>
  </section>
</Base>

<style>
  .resume {
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--space-8) var(--container-pad) var(--space-9);
  }

  .head {
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: var(--space-6);
    margin-bottom: var(--space-7);
  }

  .kicker {
    color: var(--neon-magenta);
    font-size: var(--text-xs);
    letter-spacing: 0.18em;
    margin-bottom: var(--space-3);
  }

  h1 {
    font-size: var(--text-3xl);
  }

  .role {
    color: var(--neon-violet);
    font-size: var(--text-sm);
    margin-top: var(--space-2);
  }

  .summary {
    max-width: 64ch;
    margin-top: var(--space-4);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .block {
    margin-top: var(--space-7);
  }

  .block h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-4);
  }

  .jobs {
    display: grid;
    gap: var(--space-5);
  }

  .job {
    border-left: 2px solid var(--border-subtle);
    padding-left: var(--space-5);
  }

  .place {
    color: var(--text-high);
    font-family: var(--font-display);
    font-weight: 500;
  }

  .job-role {
    color: var(--neon-magenta);
    font-size: var(--text-sm);
    margin-top: var(--space-1);
  }

  .period {
    color: var(--text-muted);
    font-size: var(--text-xs);
    margin-top: var(--space-1);
  }

  .job ul {
    margin-top: var(--space-3);
    padding-left: var(--space-5);
    display: grid;
    gap: var(--space-2);
    max-width: 70ch;
  }

  .job li {
    font-size: var(--text-sm);
  }

  .selected {
    padding-left: var(--space-5);
    display: grid;
    gap: var(--space-2);
  }

  .more {
    margin-top: var(--space-3);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .skills {
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 768px) {
    .skills {
      grid-template-columns: 1fr 1fr;
    }
  }

  .skill {
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
  }

  .skill .area {
    color: var(--neon-violet);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: var(--space-1);
  }

  .skill p:last-child {
    font-size: var(--text-sm);
  }
</style>
