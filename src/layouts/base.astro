---
/**
 * Base layout: one html document per page, lang set per page (never globally).
 * The SEO cluster (canonical, hreflang, Open Graph) slots into <head> via the
 * `head` slot — U6's seo-head fills it.
 */
import '../styles/global.css';
import type { Lang } from '../i18n/ui';
import { withBase } from '../lib/urls';
import Header from '../components/header.astro';
import Footer from '../components/footer.astro';
import SeoHead from '../components/seo-head.astro';

interface Props {
  lang?: Lang;
  title: string;
  description?: string;
  footerVariant?: 'expressive' | 'medium' | 'compact' | 'home';
  pageClass?: string;
  headerVariant?: 'default' | 'center';
}

const {
  lang = 'en',
  title,
  description = '',
  footerVariant = 'medium',
  pageClass,
  headerVariant = 'default',
} = Astro.props;
---

<!doctype html>
<html lang={lang} data-type="service" data-radius="sharp" data-buttons="solid">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f4f3ee" />
    <meta name="page-type" content="service" />
    <meta name="site-kind" content="other" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <SeoHead lang={lang} title={title} description={description} />
    <slot name="head" />
  </head>
  <body class={pageClass}>
    <Header lang={lang} variant={headerVariant} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} variant={footerVariant} />
    <script type="module" src={withBase('/assets/moments/moments.js')}></script>
  </body>
</html>
