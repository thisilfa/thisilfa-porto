---
/** Featured project card: labels on top, title, overview, stack chips, and a
 * disclosure note; case studies add an arrow affordance. Data comes from the
 * projects collection (schema fields in src/lib/project-schema.ts). */
import { t, type Lang } from '../i18n/ui';
import { withBase } from '../lib/urls';

export interface CardEntry {
  slug: string;
  data: {
    title: string;
    category: string;
    overview: string;
    stack: string[];
    statusKind: 'delivered' | 'staging' | 'research' | 'unverified';
    ownership: 'employer' | 'independent' | 'unconfirmed';
    disclosure: string;
    kind: 'case-study' | 'compact';
    period?: string;
  };
}

interface Props {
  /** The listing's locale — cards link into that locale's route tree. */
  locale: Lang;
  entry: CardEntry;
}

const { locale, entry } = Astro.props;
const href = withBase(locale === 'id' ? `/id/projects/${entry.slug}/` : `/projects/${entry.slug}/`);
const isCaseStudy = entry.data.kind === 'case-study';
---

<article class="card">
  <p class="meta mono">
    <span class="category">{entry.data.category}</span>
    {entry.data.period && <span class="period">{entry.data.period}</span>}
    <span class="status status-{entry.data.statusKind}">{entry.data.statusKind}</span>
  </p>
  <div class="system-mark" role="img" aria-label={`${entry.data.title} system flow`}><i></i><i></i><i></i><i></i></div>
  <h3>{isCaseStudy ? <a href={href}>{entry.data.title}</a> : entry.data.title}</h3>
  <p class="overview">{entry.data.overview}</p>
  <ul class="stack">
    {entry.data.stack.map((tech) => (
      <li class="mono">{tech}</li>
    ))}
  </ul>
  <p class="disclosure">{entry.data.disclosure}</p>
  {isCaseStudy && (
    <p class="read">
      <a href={href}>{t(locale, 'projects.readCaseStudy')} →</a>
    </p>
  )}
</article>

<style>
  .card {
    background: transparent;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    display: grid;
    gap: var(--space-3);
    align-content: start;
    grid-template-rows: auto auto auto 1fr;
    transition:
      border-color var(--transition-fast),
      transform var(--transition-fast), background var(--transition-fast);
  }

  .card:hover {
    border-color: var(--border-strong);
    background: rgba(255, 255, 255, 0.25);
    transform: translateY(-2px);
  }

  h3 {
    font-size: clamp(1.45rem, 1.8vw, 2rem);
  }

  h3 a {
    color: var(--p-ink);
    text-decoration-color: transparent;
  }

  h3 a:hover {
    color: var(--neon-magenta);
  }

  .meta {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    font-size: var(--text-xs);
    align-items: center;
  }

  .category {
    color: var(--text-muted);
    letter-spacing: 0.08em;
  }

  .period {
    color: var(--text-muted);
  }

  .status {
    border-left: 1px solid var(--border-subtle);
    padding-left: var(--space-2);
  }

  .status-delivered {
    color: var(--neon-cyan);
    border-color: var(--border-subtle);
  }

  .status-staging {
    color: var(--neon-violet);
    border-color: var(--border-subtle);
  }

  .status-research,
  .status-unverified {
    color: var(--neon-pumpkin);
    border-color: var(--border-subtle);
  }

  .overview {
    font-size: var(--text-sm);
    max-width: 60ch;
  }

  .stack {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .stack li {
    font-size: var(--text-xs);
    color: var(--text-muted);
    border-bottom: 1px solid var(--border-subtle);
    padding: 0.15rem 0;
  }

  .disclosure {
    font-size: var(--text-xs);
    color: var(--p-ink);
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--space-3);
  }

  .read {
    margin-top: calc(-1 * var(--space-1));
  }

  .read a {
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .system-mark {
    height: 8.8rem;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    align-items: center;
    gap: 0.65rem;
    padding: 1.25rem;
    background: var(--p-ink);
    border-radius: var(--radius-sm);
  }

  .system-mark i {
    display: block;
    height: 0.7rem;
    background: var(--p-bg);
    border-radius: 1px;
    position: relative;
  }

  .system-mark i::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 100%;
    width: 1px;
    height: 1rem;
    background: var(--p-accent);
  }

  .system-mark i:nth-child(2) { height: 2.3rem; background: #d2b46f; }
  .system-mark i:nth-child(3) { height: 3.6rem; background: var(--p-accent); }
  .system-mark i:nth-child(4) { height: 1.5rem; }

  @media (max-width: 639px) {
    h3 a {
      display: inline-flex;
      min-height: 44px;
      align-items: center;
    }
  }
</style>
