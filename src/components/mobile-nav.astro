---
/** Mobile navigation disclosure. Vanilla script, no hydration: a toggle with
 * aria-expanded, Escape to close, focus returns to the toggle. Hidden above
 * 640px — the desktop nav in header.astro takes over there. */
import { navItems, navPaths, t, type Lang } from '../i18n/ui';
import { localizedPath } from '../i18n/utils';
import { withBase } from '../lib/urls';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const hrefFor = (path: string) => withBase(localizedPath(path, lang));
---

<div class="mobile-nav">
  <button type="button" class="toggle" aria-expanded="false" aria-controls="mobile-menu">
    <span class="toggle-lines" aria-hidden="true"><i></i><i></i></span>
    <span class="visually-hidden">Menu</span>
  </button>
  <nav id="mobile-menu" class="panel" hidden aria-label={t(lang, 'nav.home')}>
    {navItems.map((item) => (
      <a href={hrefFor(navPaths[item])}>{t(lang, `nav.${item}` as const)}</a>
    ))}
  </nav>
</div>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.mobile-nav .toggle');
  const panel = document.querySelector<HTMLElement>('.mobile-nav .panel');

  if (toggle && panel) {
    const close = () => {
      toggle.setAttribute('aria-expanded', 'false');
      panel.hidden = true;
      toggle.focus();
    };

    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      panel.hidden = open;
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        close();
      }
    });

    panel.addEventListener('click', (event) => {
      if (event.target instanceof HTMLAnchorElement) {
        toggle.setAttribute('aria-expanded', 'false');
        panel.hidden = true;
      }
    });
  }
</script>

<style>
  .mobile-nav {
    display: none;
    position: relative;
  }

  @media (max-width: 1023px) {
    .mobile-nav {
      display: block;
    }
  }

  .toggle {
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .toggle:hover { border-color: var(--p-ink); }
  .toggle-lines { width: 1rem; display: grid; gap: 0.28rem; }
  .toggle-lines i { display: block; height: 1px; background: currentColor; }

  .panel {
    position: fixed;
    inset: var(--nav-height) 0 0;
    background: var(--canvas);
    border-top: 1px solid var(--rule);
    display: grid;
    align-content: start;
    padding: var(--space-6) var(--container-pad);
  }

  .panel a {
    min-height: 56px;
    display: flex;
    align-items: center;
    color: var(--ink);
    text-decoration: none;
    padding: 1rem 0;
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-sans);
    font-size: var(--text-2xl);
  }

  .panel a:hover {
      color: var(--blue);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
