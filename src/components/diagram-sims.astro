---
interface Props {
  lang: 'en' | 'id';
  title: string;
  desc: string;
  legend: { implemented: string; integration: string; context: string };
  scrollHint?: string;
  compact?: boolean;
}

const { lang, title, desc, legend, compact = false } = Astro.props;
const isId = lang === 'id';

const phases = isId
  ? [
      {
        title: '01 · Akuisisi',
        nodes: [
          ['context', 'Tujuh kamera di rak', 'Citra rak setiap 30 menit dan saat kuantitas berubah'],
          ['context', 'Empat Raspberry Pi 4', 'Perangkat edge menangkap dan mengirim citra'],
          ['integration', 'MQTT', 'Integrasi dengan infrastruktur yang sudah ada'],
        ],
      },
      {
        title: '02 · Inferensi',
        nodes: [
          ['implemented', 'Antrian tugas Redis', 'Pemrosesan tugas antara capture dan inferensi'],
          ['implemented', 'Layanan inferensi FastAPI', 'Server terpusat dan integrasi pipeline YOLO'],
          ['implemented', 'Segmentasi YOLOv8', 'Mendeteksi permukaan kotak yang terlihat'],
          ['implemented', 'Logika penghitungan geometri', 'Menyimpulkan kotak tersembunyi dari relasi spasial'],
        ],
      },
      {
        title: '03 · Hasil',
        nodes: [
          ['implemented', 'Hasil dan pemantauan deteksi', 'Tinjauan ketidaksesuaian dan performa harian'],
          ['integration', 'Sistem inventaris', 'Layanan inferensi terhubung ke sistem yang lebih luas'],
          ['integration', 'Deployment AWS', 'Dikerjakan bersama tim infrastruktur'],
        ],
      },
    ]
  : [
      {
        title: '01 · Capture',
        nodes: [
          ['context', 'Seven shelf cameras', 'Shelf images every 30 minutes and on quantity-change events'],
          ['context', 'Four Raspberry Pi 4 devices', 'Edge devices capture and send images'],
          ['integration', 'MQTT', 'Integration with the existing infrastructure'],
        ],
      },
      {
        title: '02 · Inference',
        nodes: [
          ['implemented', 'Redis task queue', 'Task processing between capture and inference'],
          ['implemented', 'FastAPI inference service', 'Centralized server and YOLO pipeline integration'],
          ['implemented', 'YOLOv8 segmentation', 'Detects the visible surfaces of stacked boxes'],
          ['implemented', 'Geometry counting logic', 'Infers hidden boxes from spatial relationships'],
        ],
      },
      {
        title: '03 · Delivery',
        nodes: [
          ['implemented', 'Results and detection monitoring', 'Daily discrepancy and performance review'],
          ['integration', 'Inventory system', 'Inference service integrated into the wider system'],
          ['integration', 'AWS deployment', 'Completed with the infrastructure team'],
        ],
      },
    ];
---

<div class:list={['architecture', { 'architecture--compact': compact }]} data-diagram aria-labelledby="sims-map-title" aria-describedby="sims-map-desc">
  <div class="architecture__head">
    <div>
      <p class="architecture__label mono">{isId ? 'Alur sistem yang digeneralkan' : 'Generalized system flow'}</p>
      <h3 id="sims-map-title">{title}</h3>
    </div>
    <ul class="legend" aria-label={isId ? 'Legenda kontribusi' : 'Contribution legend'}>
      <li class="implemented">{legend.implemented}</li>
      <li class="integration">{legend.integration}</li>
      <li class="context">{legend.context}</li>
    </ul>
  </div>

  <p id="sims-map-desc" class="visually-hidden">{desc}</p>

  <div class="phase-grid">
    {phases.map((phase) => (
      <section class="phase">
        <h4 class="mono">{phase.title}</h4>
        <ol>
          {phase.nodes.map(([kind, name, detail]) => (
            <li class={`node node--${kind}`}>
              <span class="node__name">{name}</span>
              <span class="node__detail">{detail}</span>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</div>

<style>
  .architecture {
    width: 100%;
    min-width: 0;
    padding: clamp(1.25rem, 2.4vw, 2rem);
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .architecture__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-6);
    align-items: end;
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--rule);
  }

  .architecture__label { margin-bottom: var(--space-2); color: var(--blue); font-size: var(--text-xs); }
  .architecture h3 { max-width: 20ch; font-size: clamp(1.5rem, 2.4vw, 2.25rem); }

  .legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .legend li { display: inline-flex; align-items: center; gap: var(--space-2); }
  .legend li::before { width: 0.625rem; height: 0.625rem; border: 1px solid currentColor; content: ''; }
  .legend .implemented { color: var(--blue); }
  .legend .implemented::before { background: var(--blue); }
  .legend .integration { color: var(--ink); }
  .legend .integration::before { border-color: var(--amber); border-style: dashed; }
  .legend .context { color: var(--ink-soft); }
  .legend .context::before { background: var(--surface-strong); }

  .phase-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
    padding-top: var(--space-6);
  }

  .phase { min-width: 0; position: relative; }
  .phase:not(:last-child)::after {
    position: absolute;
    top: 50%;
    right: calc(-1 * var(--space-5));
    width: var(--space-5);
    height: 1px;
    background: var(--ink-soft);
    content: '';
  }

  .phase h4 {
    margin: 0 0 var(--space-3);
    color: var(--ink-soft);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0;
  }

  .phase ol { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); }
  .node {
    min-height: 5.75rem;
    position: relative;
    padding: var(--space-4);
    border: 1px solid var(--rule);
    background: var(--canvas);
  }

  .node:not(:last-child)::after {
    position: absolute;
    bottom: calc(-1 * var(--space-3));
    left: 50%;
    width: 1px;
    height: var(--space-3);
    background: var(--ink-soft);
    content: '';
  }

  .node--implemented { border-left: 3px solid var(--blue); }
  .node--integration { border-left: 3px dashed var(--amber); }
  .node--context { border-left: 3px solid var(--rule); background: color-mix(in srgb, var(--canvas) 72%, var(--surface-strong)); }
  .node__name { display: block; color: var(--ink); font-family: var(--font-mono); font-size: 0.875rem; font-weight: 500; line-height: 1.35; }
  .node__detail { display: block; margin-top: var(--space-2); color: var(--ink-soft); font-size: 0.875rem; line-height: 1.45; }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .architecture--compact .node { min-height: 4.75rem; }
  .architecture--compact .node__detail { display: none; }

  @media (max-width: 1023px) {
    .architecture__head { grid-template-columns: 1fr; align-items: start; }
    .legend { justify-content: flex-start; }
    .phase-grid { grid-template-columns: 1fr; }
    .phase:not(:last-child)::after {
      top: auto;
      right: auto;
      bottom: calc(-1 * var(--space-5));
      left: 50%;
      width: 1px;
      height: var(--space-5);
    }
  }

  @media (max-width: 639px) {
    .architecture { padding: var(--space-4); }
    .architecture__head { padding-bottom: var(--space-5); }
    .legend { display: grid; gap: var(--space-2); }
    .phase-grid { gap: var(--space-6); padding-top: var(--space-5); }
    .phase:not(:last-child)::after { bottom: calc(-1 * var(--space-6)); height: var(--space-6); }
    .node { min-height: 0; }
    .node__name,
    .node__detail { font-size: 0.875rem; }
  }
</style>
