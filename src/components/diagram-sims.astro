---
/**
 * SIMS architecture diagram — generalized, ownership-encoded inline SVG.
 * Three treatments: implemented stages (solid, magenta accent), contributed
 * integration points (dashed, violet), and context stages that the source
 * material does not attribute (muted). Stage labels stay in technical
 * English (language-neutral); the title, description, legend, and scroll
 * hint are localized props. Zero client JavaScript — pure inline SVG.
 */
interface Props {
  lang: 'en' | 'id';
  title: string;
  desc: string;
  legend: { implemented: string; integration: string; context: string };
  scrollHint: string;
}

const { title, desc, legend, scrollHint } = Astro.props;
---

<figure class="diagram-figure">
  <div class="diagram-scroll">
    <svg
      role="img"
      viewBox="0 0 960 300"
      width="960"
      height="300"
      xmlns="http://www.w3.org/2000/svg"
      aria-labelledby="sims-diagram-title sims-diagram-desc"
      class="diagram"
    >
      <title id="sims-diagram-title">{title}</title>
      <desc id="sims-diagram-desc">{desc}</desc>
      <defs>
        <marker
          id="arrow"
          viewBox="0 0 10 10"
          refX="9"
          refY="5"
          markerWidth="7"
          markerHeight="7"
          orient="auto-start-reverse"
        >
          <path d="M 0 0 L 10 5 L 0 10 z" class="arrow-head"></path>
        </marker>
        <marker
          id="arrow-muted"
          viewBox="0 0 10 10"
          refX="9"
          refY="5"
          markerWidth="7"
          markerHeight="7"
          orient="auto-start-reverse"
        >
          <path d="M 0 0 L 10 5 L 0 10 z" class="arrow-head-muted"></path>
        </marker>
      </defs>

      <!-- Context stages: not individually attributed (muted) -->
      <g class="node context">
        <rect x="8" y="60" width="140" height="58" rx="10"></rect>
        <text x="78" y="84" text-anchor="middle">
          Cameras
        </text>
        <text x="78" y="102" text-anchor="middle" class="sub">
          on shelves
        </text>
      </g>
      <g class="node context">
        <rect x="168" y="60" width="150" height="58" rx="10"></rect>
        <text x="243" y="84" text-anchor="middle">
          Edge capture
        </text>
        <text x="243" y="102" text-anchor="middle" class="sub">
          Raspberry Pi 4
        </text>
      </g>

      <!-- Implemented stages (solid) -->
      <g class="node implemented">
        <rect x="338" y="60" width="150" height="58" rx="10"></rect>
        <text x="413" y="84" text-anchor="middle">
          YOLOv8 segmentation
        </text>
        <text x="413" y="102" text-anchor="middle" class="sub">
          + counting logic
        </text>
      </g>
      <g class="node implemented">
        <rect x="508" y="60" width="140" height="58" rx="10"></rect>
        <text x="578" y="84" text-anchor="middle">
          FastAPI
        </text>
        <text x="578" y="102" text-anchor="middle" class="sub">
          inference service
        </text>
      </g>
      <g class="node implemented">
        <rect x="668" y="60" width="120" height="58" rx="10"></rect>
        <text x="728" y="84" text-anchor="middle">
          Redis
        </text>
        <text x="728" y="102" text-anchor="middle" class="sub">
          task queue
        </text>
      </g>
      <g class="node implemented">
        <rect x="808" y="60" width="144" height="58" rx="10"></rect>
        <text x="880" y="84" text-anchor="middle">
          Inventory results
        </text>
        <text x="880" y="102" text-anchor="middle" class="sub">
          + monitoring
        </text>
      </g>

      <!-- Contributed / integration points (dashed) -->
      <g class="node integration">
        <rect x="178" y="180" width="130" height="46" rx="10"></rect>
        <text x="243" y="208" text-anchor="middle">
          MQTT (existing)
        </text>
      </g>
      <g class="node integration">
        <rect x="523" y="180" width="110" height="46" rx="10"></rect>
        <text x="578" y="208" text-anchor="middle">
          AWS (infra)
        </text>
      </g>

      <!-- Flow arrows -->
      <g class="flow">
        <line x1="148" y1="89" x2="166" y2="89" marker-end="url(#arrow-muted)"></line>
        <line x1="318" y1="89" x2="336" y2="89" marker-end="url(#arrow)"></line>
        <line x1="488" y1="89" x2="506" y2="89" marker-end="url(#arrow)"></line>
        <line x1="648" y1="89" x2="666" y2="89" marker-end="url(#arrow)"></line>
        <line x1="788" y1="89" x2="806" y2="89" marker-end="url(#arrow)"></line>
        <line
          x1="243"
          y1="118"
          x2="243"
          y2="178"
          class="dashed"
          marker-end="url(#arrow-muted)"
        ></line>
        <line x1="578" y1="118" x2="578" y2="178" class="dashed" marker-end="url(#arrow)"></line>
      </g>

      <!-- Localized ownership legend -->
      <g class="legend">
        <rect x="8" y="256" width="14" height="14" rx="4" class="swatch implemented"></rect>
        <text x="28" y="267">
          {legend.implemented}
        </text>
        <rect x="170" y="256" width="14" height="14" rx="4" class="swatch integration"></rect>
        <text x="190" y="267">
          {legend.integration}
        </text>
        <rect x="392" y="256" width="14" height="14" rx="4" class="swatch context"></rect>
        <text x="412" y="267">
          {legend.context}
        </text>
      </g>
    </svg>
  </div>
  <figcaption class="scroll-hint mono">{scrollHint} →</figcaption>
</figure>

<style>
  .diagram-figure {
    margin: var(--space-5) 0 0;
  }

  .diagram-scroll {
    overflow-x: auto;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--surface-1);
    padding: var(--space-3);
  }

  .diagram {
    display: block;
    min-width: 700px;
    height: auto;
  }

  .scroll-hint {
    display: none;
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  @media (max-width: 760px) {
    .scroll-hint {
      display: block;
    }
  }

  /* Node treatments */
  .node rect {
    fill: var(--surface-2);
  }

  .node.implemented rect {
    stroke: var(--neon-magenta);
    stroke-width: 1.5;
  }

  .node.implemented text {
    fill: var(--text-high);
  }

  .node.integration rect {
    stroke: var(--neon-violet);
    stroke-width: 1.2;
    stroke-dasharray: 5 4;
  }

  .node.integration text {
    fill: var(--text-body);
  }

  .node.context rect {
    stroke: var(--border-subtle);
    stroke-width: 1;
  }

  .node.context text {
    fill: var(--text-muted);
  }

  .node text {
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .node .sub {
    font-size: 11px;
    opacity: 0.75;
  }

  /* Flow lines */
  .flow line {
    stroke: var(--text-muted);
    stroke-width: 1.5;
  }

  .flow line.dashed {
    stroke-dasharray: 5 4;
  }

  .arrow-head {
    fill: var(--neon-magenta);
  }

  .arrow-head-muted {
    fill: var(--text-muted);
  }

  /* Legend */
  .legend .swatch.implemented {
    fill: var(--neon-magenta);
  }

  .legend .swatch.integration {
    fill: none;
    stroke: var(--neon-violet);
    stroke-width: 1.4;
    stroke-dasharray: 4 3;
  }

  .legend .swatch.context {
    fill: var(--surface-2);
    stroke: var(--border-subtle);
  }

  .legend text {
    fill: var(--text-body);
    font-family: var(--font-body);
    font-size: 13px;
  }
</style>
