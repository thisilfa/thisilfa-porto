      if (gallery && galleryFirstRow && gallerySecondRow) {
        const bounds = gallery.getBoundingClientRect();
        const scrollRange = Math.max(1, bounds.height - viewHeight);
        const journey = clamp(-bounds.top / scrollRange);
        const firstReveal = smoothstep(0.04, 0.78, journey);
        const secondReveal = smoothstep(0.16, 0.92, journey);
        const mobile = window.innerWidth < 768;
        const firstTravel = mobile
          ? Math.max(window.innerWidth, galleryFirstRow.scrollWidth - window.innerWidth + 40)
          : Math.min(window.innerWidth * 0.62, 720);
        const secondTravel = mobile ? window.innerWidth : Math.min(window.innerWidth * 0.62, 720);
        const secondFinal = mobile
          ? -Math.max(0, gallerySecondRow.scrollWidth - window.innerWidth + 40)
          : 0;
        const firstX = -firstTravel * (1 - firstReveal);
        const secondX = secondTravel + (secondFinal - secondTravel) * secondReveal;

        gallery.style.setProperty('--gallery-row-first-x', `${firstX.toFixed(2)}px`);
        gallery.style.setProperty('--gallery-row-second-x', `${secondX.toFixed(2)}px`);
      }

      if (timeline) {
        const bounds = timeline.getBoundingClientRect();
        const progress = clamp((viewHeight * 0.78 - bounds.top) / (bounds.height * 0.82));
        timeline.style.setProperty('--timeline-progress', progress.toFixed(3));
        timelineSteps.forEach((step, index) => {
          const threshold = index / Math.max(1, timelineSteps.length - 1);
          step.classList.toggle('is-active', progress >= threshold * 0.9);
        });
      }
    };

    const scheduleScrollMoments = () => {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(updateScrollMoments);
    };

    window.addEventListener('scroll', scheduleScrollMoments, { passive: true });
    window.addEventListener('resize', scheduleScrollMoments, { passive: true });
    updateScrollMoments();
  } else {
    timelineSteps.forEach((step) => step.classList.add('is-active'));
  }
</script>
