  const bridge = document.querySelector<HTMLElement>('[data-scroll-bridge]');
  const gallery = document.querySelector<HTMLElement>('[data-scroll-gallery]');
  const galleryFirstRow = gallery?.querySelector<HTMLElement>('[data-gallery-row="first"]');
  const gallerySecondRow = gallery?.querySelector<HTMLElement>('[data-gallery-row="second"]');
  const philosophySteps = bridge
    ? [...bridge.querySelectorAll<HTMLElement>('[data-philosophy-step]')]
    : [];
  const timeline = document.querySelector<HTMLElement>('[data-method-timeline]');
  const timelineSteps = timeline
    ? [...timeline.querySelectorAll<HTMLElement>('[data-timeline-step]')]
    : [];

  if (!reduceMotion && (bridge || gallery || timeline)) {
    let scheduled = false;
    const clamp = (value: number) => Math.max(0, Math.min(1, value));
    const smoothstep = (start: number, end: number, value: number) => {
      const progress = clamp((value - start) / (end - start));
      return progress * progress * (3 - 2 * progress);
    };

    const updateScrollMoments = () => {
      scheduled = false;
      const viewHeight = window.innerHeight;

      if (bridge) {
        const bounds = bridge.getBoundingClientRect();
        const scrollRange = Math.max(1, bounds.height - viewHeight);
        const journey = clamp(-bounds.top / scrollRange);
        const taglineMotion = smoothstep(0.04, 0.31, journey);
        const taglineOpacity = 1 - smoothstep(0.18, 0.31, journey);
        const philosophyVisible = journey >= 0.32 ? 1 : 0;

        bridge.style.setProperty('--tagline-opacity', taglineOpacity.toFixed(3));
        bridge.style.setProperty('--beyond-x', `${(-48 * taglineMotion).toFixed(2)}px`);
        bridge.style.setProperty('--systems-x', `${(48 * taglineMotion).toFixed(2)}px`);
        bridge.style.setProperty(
          '--tagline-tracking',
          `${(-0.055 + taglineMotion * 0.03).toFixed(4)}em`,
        );
        bridge.style.setProperty('--philosophy-opacity', String(philosophyVisible));
        bridge.style.setProperty('--philosophy-y', philosophyVisible ? '0px' : '18px');

        philosophySteps.forEach((step, index) => {
          const reveal = smoothstep(0.34 + index * 0.025, 0.42 + index * 0.025, journey);
          step.style.setProperty('--principle-clip', `${((1 - reveal) * 100).toFixed(2)}%`);
          step.style.setProperty('--principle-y', `${((1 - reveal) * 18).toFixed(2)}px`);
