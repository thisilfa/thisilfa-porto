<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const animatePetals = (canvas: HTMLCanvasElement) => {
    const context = canvas.getContext('2d');
    const isFooter = canvas.dataset.petals === 'footer';
    const petalCount = window.innerWidth < 640 ? (isFooter ? 5 : 6) : isFooter ? 8 : 10;
    const petals = Array.from({ length: petalCount }, (_, index) => ({
      x: (index + 0.65) / petalCount,
      size: (isFooter ? 18 : 11) + (index % 4) * (isFooter ? 5 : 3),
      duration: 14000 + (index % 6) * 1800,
      offset: (index % 5) * 1700,
      sway: 22 + (index % 3) * 14,
      opacity: (isFooter ? 0.2 : 0.3) + (index % 3) * 0.08,
    }));
    const start = performance.now();

    const resize = () => {
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      const bounds = canvas.getBoundingClientRect();
      canvas.width = Math.round(bounds.width * ratio);
      canvas.height = Math.round(bounds.height * ratio);
      context?.setTransform(ratio, 0, 0, ratio, 0, 0);
    };

    const draw = (now: number) => {
      if (!context) return;
      const bounds = canvas.getBoundingClientRect();
      context.clearRect(0, 0, bounds.width, bounds.height);
      let active = false;

      petals.forEach((petal, index) => {
        const rawProgress = (now - start + petal.offset) / petal.duration;
        const progress = isFooter ? rawProgress % 1 : Math.min(rawProgress, 1);
        if (progress >= 1) return;
        active = isFooter || progress < 1;
        const eased = progress * progress * (3 - 2 * progress);
        const x = petal.x * bounds.width + Math.sin(progress * Math.PI * 3 + index) * petal.sway;
        const y = -30 + eased * (bounds.height + 60);

        context.save();
        context.translate(x, y);
        context.rotate(progress * Math.PI * 2 + index * 0.4);
        const exitFade = Math.max(0, Math.min(1, (0.78 - progress) / 0.18));
        context.globalAlpha = petal.opacity * exitFade;
        context.fillStyle = '#d8a7ad';
        context.beginPath();
        context.ellipse(0, 0, petal.size * 0.55, petal.size, 0.45, 0, Math.PI * 2);
        context.fill();
        context.restore();
      });

      if (active) requestAnimationFrame(draw);
    };

    resize();
    window.addEventListener('resize', resize, { passive: true });
    requestAnimationFrame(draw);
  };

  if (!reduceMotion) {
    document
      .querySelectorAll<HTMLCanvasElement>('.editorial-home .petal-canvas')
      .forEach((canvas) => {
        if (canvas.dataset.petals === 'footer' && 'IntersectionObserver' in window) {
          const observer = new IntersectionObserver(
            (entries) => {
              if (!entries.some((entry) => entry.isIntersecting)) return;
              observer.disconnect();
              animatePetals(canvas);
