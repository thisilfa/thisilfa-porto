---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import headshot from '../assets/editorial-headshot.png';
import cssdVisual from '../assets/projects/cssd.png';
import faceAttendanceVisual from '../assets/projects/face-attendance.png';
import materialsCountingVisual from '../assets/projects/materials-counting.png';
import simsVisual from '../assets/projects/sims.png';
import workguardVisual from '../assets/projects/workguard.png';
import type { Lang } from '../i18n/ui';
import { entrySlug } from '../lib/content';
import { withBase } from '../lib/urls';

interface Props {
  lang: Lang;
  featured: CollectionEntry<'projects'>[];
  projects: CollectionEntry<'projects'>[];
  projectCount: number;
}

const { lang, featured, projects, projectCount } = Astro.props;
const isId = lang === 'id';
const projectsHref = withBase(isId ? '/id/projects/' : '/projects/');
const aboutHref = withBase(isId ? '/id/about/' : '/about/');
const projectHref = (entry: CollectionEntry<'projects'>) =>
  withBase(isId ? `/id/projects/${entrySlug(entry.id)}/` : `/projects/${entrySlug(entry.id)}/`);

const galleryAssets = {
  sims: simsVisual,
  'cssd-instrument-id': cssdVisual,
  workguard: workguardVisual,
  'face-attendance': faceAttendanceVisual,
  'yolov5-counting': materialsCountingVisual,
};

const galleryOrder = [
  'sims',
  'cssd-instrument-id',
  'workguard',
  'face-attendance',
  'yolov5-counting',
];
const galleryProjects = galleryOrder
  .map((slug) => projects.find((entry) => entrySlug(entry.id) === slug))
  .filter((entry): entry is CollectionEntry<'projects'> => Boolean(entry));

const galleryAlt = (slug: string) => {
  const labels = isId
    ? {
        sims: 'Visual penghitungan empat zona SKU pada rak untuk proyek SIMS',
        'cssd-instrument-id': 'Visual identifikasi dan pemeriksaan abnormalitas instrumen bedah',
        workguard: 'Visual deteksi aktivitas dan pelanggaran keselamatan kerja dari CCTV',
        'face-attendance': 'Visual sistem presensi wajah dan alur integrasinya',
        'yolov5-counting': 'Visual penghitungan material dengan deteksi objek YOLO',
      }
    : {
        sims: 'Four-zone shelf SKU counting visual for the SIMS project',
        'cssd-instrument-id':
          'Surgical instrument identification and abnormality inspection visual',
        workguard: 'CCTV workplace activity and safety violation detection visual',
        'face-attendance': 'Face attendance system and integration workflow visual',
        'yolov5-counting': 'YOLO object-detection visual for materials counting',
      };

  return labels[slug as keyof typeof labels];
};

const stages = isId
  ? [
      ['Masalah', 'Batasan, data, dan bukti operasional'],
      ['Kecerdasan', 'Model, retrieval, dan evaluasi'],
      ['Integrasi', 'API, data, dan antarmuka sistem'],
      ['Operasi', 'Deployment, monitoring, dan iterasi'],
    ]
  : [
      ['Problem', 'Constraints, data, and operational evidence'],
      ['Intelligence', 'Models, retrieval, and evaluation'],
      ['Integration', 'APIs, data, and system interfaces'],
      ['Operation', 'Deployment, monitoring, and iteration'],
    ];

const philosophy = isId
  ? [
      ['Masalah sebelum teknologi', 'Pahami masalah sebelum memilih model atau framework.'],
      ['Eksperimentasi, bukan asumsi', 'Validasi keputusan teknis melalui eksperimen.'],
      ['Pemikiran end-to-end', 'Pertimbangkan sistem secara utuh, bukan hanya modelnya.'],
      ['Rekayasa praktis', 'Utamakan keandalan, kemudahan pemeliharaan, dan hasil yang terukur.'],
    ]
  : [
      [
        'Problem before technology',
        'Understand the problem before selecting a model or framework.',
      ],
      ['Experimentation over assumptions', 'Validate technical decisions through experiments.'],
      ['End-to-end thinking', 'Consider the complete system, not only the model.'],
      [
        'Practical engineering',
        'Prioritize reliability, maintainability, and measurable outcomes.',
      ],
    ];
---

<section class="editorial-hero" data-enter>
  <canvas class="petals petal-canvas" data-petals="hero" aria-hidden="true"></canvas>
  <div class="wrap hero-layout">
    <div class="hero-text">
      <p class="hero-kicker mono">AI Engineer · Computer Vision · Applied AI</p>
      <h1>
        {isId ? 'Rekayasa AI untuk sistem operasional.' : 'AI engineering for real-world systems.'}
      </h1>
      <p class="hero-lede">
        {isId
          ? 'Saya menghubungkan eksperimen machine learning dengan sistem yang dapat dipakai, dari pipeline computer vision hingga API dan deployment.'
          : 'I connect machine-learning experiments to systems people can use, from computer vision pipelines to APIs and deployment.'}
      </p>
      <div class="hero-facts" aria-label={isId ? 'Ringkasan portofolio' : 'Portfolio summary'}>
        <p>
          <strong>{projectCount}</strong>
          <span>{isId ? 'proyek terdokumentasi' : 'documented projects'}</span>
        </p>
        <p>
          <strong>{featured.length}</strong>
          <span>{isId ? 'studi kasus lengkap' : 'complete case studies'}</span>
        </p>
      </div>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#selected-work">
          {isId ? 'Lihat proyek pilihan' : 'View selected work'}
        </a>
        <a class="btn btn-secondary" href={aboutHref}>
          {isId ? 'Tentang saya' : 'About me'}
        </a>
      </div>
    </div>

    <div class="hero-portrait">
      <Image
        src={headshot}
        alt={isId ? 'Potret Silfaradila Mei' : 'Portrait of Silfaradila Mei'}
        widths={[480, 720, 1000]}
        sizes="(max-width: 639px) 72vw, (max-width: 1023px) 42vw, 44vw"
        loading="eager"
      />
      <span class="portrait-orbit" aria-hidden="true"></span>
    </div>
  </div>
</section>

<section class="system-bridge" data-scroll-bridge aria-labelledby="bridge-title">
  <div class="wrap bridge-inner">
    <div class="bridge-phase bridge-tagline">
      <h2 id="bridge-title">
        <span class="tagline-line tagline-line--beyond">
          {isId ? 'Melampaui Model.' : 'Beyond Models.'}
        </span>
        <span class="tagline-line tagline-line--systems">
          {isId ? 'Menuju Sistem.' : 'Into Systems.'}
        </span>
      </h2>
    </div>

    <div class="bridge-phase engineering-philosophy" aria-labelledby="philosophy-title">
      <div class="philosophy-layout">
        <h2 id="philosophy-title">{isId ? 'Filosofi rekayasa.' : 'Engineering philosophy.'}</h2>
        <ol class="philosophy-list">
          {philosophy.map(([title, detail]) => (
            <li data-philosophy-step>
              <h3>{title}</h3>
              <p>{detail}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

{galleryProjects.length > 0 && (
  <section
    class="selected-work"
    id="selected-work"
    data-scroll-gallery
    aria-labelledby="gallery-title"
  >
    <div class="gallery-sticky wrap">
      <div class="gallery-inner">
        <div class="gallery-heading">
          <div>
            <p class="section-label mono">{isId ? 'Proyek pilihan' : 'Selected work'}</p>
            <h2 id="gallery-title">{isId ? 'Galeri sistem AI.' : 'AI systems gallery.'}</h2>
          </div>
          <a class="all-work" href={projectsHref}>
            {isId ? 'Lihat semua proyek' : 'View all projects'} <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="gallery-rows">
          {[galleryProjects.slice(0, 3), galleryProjects.slice(3)].map((row, rowIndex) => (
            <div
              class:list={[
                'gallery-row',
                rowIndex === 0 ? 'gallery-row--first' : 'gallery-row--second',
              ]}
              data-gallery-row={rowIndex === 0 ? 'first' : 'second'}
            >
              {row.map((entry) => {
                const slug = entrySlug(entry.id);
                const CardTag = entry.data.kind === 'case-study' ? 'a' : 'div';
                return (
                  <article class="work-card">
                    <CardTag
                      class="work-card__inner"
                      href={entry.data.kind === 'case-study' ? projectHref(entry) : undefined}
                      aria-label={
                        entry.data.kind === 'case-study'
                          ? `${isId ? 'Buka' : 'Open'} ${entry.data.title}`
                          : undefined
                      }
                    >
                      <div class="work-card__visual">
                        <Image
                          src={galleryAssets[slug as keyof typeof galleryAssets]}
                        alt={galleryAlt(slug)}
                        widths={[520, 760, 1000]}
                        sizes="(max-width: 767px) 72vw, 27rem"
                        loading="lazy"
                      />
                      </div>
                      <div class="work-card__body">
                        <h3>{entry.data.title}</h3>
                        <ul
                          aria-label={isId ? 'Keahlian dan teknologi' : 'Skills and technologies'}
                        >
                          {entry.data.stack.slice(0, 5).map((skill) => (
                            <li>{skill}</li>
                          ))}
                        </ul>
                      </div>
                    </CardTag>
                  </article>
                );
              })}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
)}

<section class="method-section" aria-labelledby="method-title">
  <div class="wrap method-layout">
    <div class="method-heading">
      <p class="section-label mono">{isId ? 'Cara kerja' : 'Engineering method'}</p>
      <h2 id="method-title">
        {isId ? 'Dari masalah hingga operasi.' : 'From problem to operation.'}
      </h2>
    </div>
    <div class="timeline" data-method-timeline>
      <span class="timeline-progress" aria-hidden="true"></span>
      <ol class="method-steps">
        {stages.map(([title, detail]) => (
          <li data-timeline-step>
            <span class="method-node" aria-hidden="true"></span>
            <h3>{title}</h3>
            <p>{detail}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .editorial-home {
    --home-section-pad: clamp(4.5rem, 8vh, 7rem);
  }

  .editorial-hero,
  .selected-work,
  .method-section,
  .profile-section {
    color: var(--ink);
  }

  .editorial-hero {
    height: calc(100svh - var(--nav-height));
    min-height: 44rem;
    position: relative;
    overflow: hidden;
    background: var(--canvas);
  }

  .hero-layout {
    height: 100%;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--grid-gap);
    align-items: center;
    padding-block: var(--space-7);
    position: relative;
    z-index: 1;
  }

  .hero-text {
    grid-column: 1 / span 6;
    position: relative;
    z-index: 2;
  }
  .hero-kicker,
  .section-label {
    color: var(--blue);
    font-size: var(--text-xs);
    font-weight: 500;
  }
  .hero-text h1 {
    max-width: 12ch;
    margin-top: var(--space-5);
    font-family: var(--font-editorial);
    font-size: clamp(4rem, 6.3vw, 5.75rem);
    font-weight: 400;
    line-height: 0.96;
    letter-spacing: -0.035em;
  }
  .hero-lede {
    max-width: 38rem;
    margin-top: var(--space-6);
    font-size: var(--text-lg);
    line-height: 1.55;
  }
  .hero-facts {
    max-width: 31rem;
    display: flex;
    gap: var(--space-6);
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
  }
  .hero-facts p {
    min-width: 0;
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }
  .hero-facts p + p {
    padding-left: var(--space-6);
    border-left: 1px solid var(--rule);
  }
  .hero-facts strong {
    color: var(--rust);
    font-family: var(--font-editorial);
    font-size: 2.35rem;
    font-weight: 400;
    line-height: 0.8;
  }
  .hero-facts span {
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.35;
  }
  .hero-actions {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-7);
  }

  .hero-portrait {
    grid-column: 7 / -1;
    justify-self: end;
    width: min(100%, 38rem);
    aspect-ratio: 1;
    position: relative;
    border-radius: 50%;
  }
  .hero-portrait :global(img) {
    width: 100%;
    height: 100%;
    border-radius: inherit;
    object-fit: cover;
    transition: transform 600ms ease;
  }
  .hero-portrait:hover :global(img) {
    transform: scale(1.025);
  }
  .portrait-orbit {
    position: absolute;
    inset: -1.5rem;
    z-index: -1;
    border: 1px solid color-mix(in srgb, var(--blue) 45%, transparent);
    border-radius: 50%;
    transform: translate(-1.5rem, 1rem);
  }

  .petals {
    width: 100%;
    height: 100%;
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  [data-enter] .hero-text > * {
    animation: enter-copy 650ms both;
  }
  [data-enter] .hero-text > :nth-child(2) {
    animation-delay: 70ms;
  }
  [data-enter] .hero-text > :nth-child(3) {
    animation-delay: 140ms;
  }
  [data-enter] .hero-text > :nth-child(4) {
    animation-delay: 210ms;
  }
  [data-enter] .hero-text > :nth-child(5) {
    animation-delay: 280ms;
  }
  [data-enter] .hero-portrait {
    animation: enter-portrait 760ms 120ms both;
  }
  @keyframes enter-copy {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes enter-portrait {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .selected-work {
    min-height: 100svh;
    padding-block: clamp(3.5rem, 6vh, 4rem);
    background: var(--surface);
  }
  .section-head {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--grid-gap);
    align-items: start;
  }
  .section-head h2,
  .profile-copy h2 {
    max-width: 15ch;
    margin-top: var(--space-4);
    font-family: var(--font-editorial);
    font-size: clamp(3rem, 4.4vw, 4.5rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.03em;
  }
  .section-head > p {
    width: 100%;
    font-size: var(--text-lg);
  }

  .project-gallery {
    margin-top: calc(var(--space-8) - 0.5rem);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-8) var(--grid-gap);
  }
  .gallery-project {
    grid-column: span 6;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(16rem, 1.1fr);
    gap: var(--space-5);
    align-items: start;
    min-width: 0;
  }
  .gallery-project--lead {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(17rem, 5fr) minmax(0, 7fr);
    gap: var(--grid-gap);
    padding-bottom: var(--space-6);
  }
  .gallery-project__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .gallery-project h3 {
    max-width: 17ch;
    margin-top: var(--space-4);
    font-family: var(--font-editorial);
    font-size: var(--text-2xl);
    font-weight: 400;
    line-height: 1.05;
  }
  .gallery-project h3 {
    font-size: var(--text-xl);
  }
  .gallery-project__visual {
    min-height: 44px;
    display: block;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: #ebe8e1;
    text-decoration: none;
    transition:
      transform var(--transition-fast),
      border-color var(--transition-fast);
  }
  .gallery-project__visual :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    display: block;
    object-fit: cover;
    transition: transform 600ms ease;
  }
  .gallery-project__visual:hover {
    transform: translateY(-2px);
    border-color: var(--blue);
  }
  .gallery-project__visual:hover :global(img) {
    transform: scale(1.025);
  }
  .gallery-project__visual:focus-visible,
  .project-link:focus-visible,
  .all-work:focus-visible {
    outline: 3px solid var(--blue);
    outline-offset: 4px;
  }
  .project-meta-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }
  .project-meta {
    color: var(--blue);
    font-size: 0.8125rem;
  }
  .project-status {
    min-height: 1.6rem;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding-inline: 0.55rem;
    border: 1px solid currentColor;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 1;
  }
  .project-status::before {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background: currentColor;
    content: '';
  }
  .project-status--delivered {
    color: var(--rust);
  }
  .project-status--staging {
    color: var(--green);
  }
  .project-status--research {
    color: var(--amber);
  }
  .project-status--unverified {
    color: var(--ink);
  }
  .project-contribution {
    max-width: 52ch;
    margin-top: var(--space-4);
    color: var(--ink);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .project-contribution b {
    color: var(--ink);
    font-weight: 500;
  }
  .project-link {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-5);
    color: var(--ink);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 0.25em;
  }
  .project-evidence {
    max-width: 28rem;
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--ink);
  }
  .project-evidence strong {
    display: block;
    color: var(--green);
    font-family: var(--font-editorial);
    font-size: clamp(2.25rem, 3vw, 2.75rem);
    font-weight: 400;
    line-height: 1;
  }
  .project-evidence span {
    display: block;
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    line-height: 1.4;
  }
  .project-evidence small {
    display: block;
    margin-top: var(--space-2);
    color: var(--ink-soft);
    font-size: 0.66rem;
    line-height: 1.4;
  }
  .all-work {
    width: 100%;
    margin-top: var(--space-7);
    padding-top: var(--space-4);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    color: var(--ink);
    font-weight: 500;
    text-decoration: none;
  }

  .method-section {
    --accent: var(--rust);
    min-height: 100svh;
    display: grid;
    align-items: center;
    background: var(--canvas);
  }
  .method-layout {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--grid-gap);
    align-items: center;
    padding-block: var(--section-pad);
  }
  .method-statement h2 {
    max-width: 14ch;
    margin-top: var(--space-5);
    color: color-mix(in srgb, var(--ink) 48%, var(--canvas));
    font-family: var(--font-editorial);
    font-size: clamp(3.5rem, 6vw, 6.5rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }
  .method-statement h2 strong {
    color: var(--rust);
    font-weight: inherit;
  }
  .method-steps {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ink);
  }
  .method-steps::before {
    width: 1px;
    position: absolute;
    top: 3.5rem;
    bottom: 3.5rem;
    left: 0.35rem;
    background: color-mix(in srgb, var(--rust) 45%, var(--rule));
    content: '';
  }
  .method-steps li {
    min-height: 7rem;
    position: relative;
    display: grid;
    grid-template-columns: 1.5rem 0.8fr 1.2fr;
    gap: var(--space-4);
    align-items: center;
    border-bottom: 1px solid var(--rule);
  }
  .method-steps .method-node {
    z-index: 1;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--rust);
  }
  .method-steps h3 {
    font-family: var(--font-editorial);
    font-size: var(--text-xl);
    font-weight: 400;
  }
  .method-steps p {
    color: var(--ink-soft);
    font-size: var(--text-sm);
  }

  .profile-section {
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding-block: var(--section-pad);
    background: var(--surface-strong);
  }
  .profile-layout {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--grid-gap);
    align-items: start;
  }
  .profile-photo {
    grid-column: 1 / span 5;
    height: min(72svh, 44rem);
    overflow: hidden;
    border-radius: var(--radius-lg);
  }
  .profile-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 28%;
    transition: transform 600ms ease;
  }
  .profile-photo:hover :global(img) {
    transform: scale(1.025);
  }
  .profile-copy {
    grid-column: 7 / -1;
  }
  .profile-copy > p:not(.section-label) {
    max-width: 40rem;
    margin-top: var(--space-6);
    font-size: var(--text-lg);
  }
  .career-list {
    margin-top: var(--space-7);
    border-top: 1px solid var(--ink);
  }
  .career-list > div {
    min-height: 5rem;
    display: grid;
    grid-template-columns: 0.8fr 1fr 1.2fr;
    gap: var(--space-4);
    align-items: center;
    border-bottom: 1px solid var(--rule);
  }
  .career-list span {
    color: var(--ink-soft);
    font-size: var(--text-xs);
  }
  .career-list strong {
    font-weight: 500;
  }
  .career-list p {
